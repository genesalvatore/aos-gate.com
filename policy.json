{
    "logLevel": "full",
    "piiAction": "warn",
    "allowedModels": [
        "claude-sonnet-4-*",
        "claude-3-5-*",
        "gpt-4o*",
        "o3*",
        "gemini-*"
    ],
    "blockedPatterns": [
        {
            "label": "AWS S3 Destructive Intent (Delete)",
            "pattern": "s3[\\s_:-]?delete",
            "flags": "gi"
        },
        {
            "label": "AWS S3 Destructive Intent (Put/Write)",
            "pattern": "s3[\\s_:-]?put",
            "flags": "gi"
        },
        {
            "label": "Stripe Destructive Intent (Delete/Cancel)",
            "pattern": "stripe[\\s_:-]?(delete|cancel)",
            "flags": "gi"
        },
        {
            "label": "SQL Drop/Delete Injection",
            "pattern": "DROP\\s+(TABLE|DATABASE)|DELETE\\s+FROM",
            "flags": "gi"
        },
        {
            "label": "Internal pricing",
            "pattern": "(?:internal|confidential)\\s+(?:pricing|rate|margin)",
            "flags": "gi"
        },
        {
            "label": "Competitor strategy",
            "pattern": "(?:competitor|rival)\\s+(?:analysis|strategy|weakness)",
            "flags": "gi"
        }
    ]
}
